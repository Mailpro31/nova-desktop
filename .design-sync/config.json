{
  "projectId": "f701e749-7e5f-4547-89ba-faf9296c694d",
  "shape": "package",
  "pkg": "nova-app",
  "globalName": "NovaDS",
  "srcDir": "src",
  "tsconfig": "tsconfig.json",
  "buildCmd": "node .ds-sync/node_modules/@tailwindcss/cli/dist/index.mjs -i .design-sync/ds.css -o .design-sync/.cache/ds-styles.css",
  "cssEntry": ".design-sync/.cache/ds-styles.css",
  "extraFonts": [".design-sync/fonts/inter.css"],
  "readmeHeader": ".design-sync/conventions.md",
  "guidelinesGlob": ["docs/design/*.md"],
  "provider": { "component": "NovaProvider" },
  "overrides": {
    "Dialog": { "cardMode": "single", "viewport": "900x620" },
    "Tooltip": { "cardMode": "single", "viewport": "900x360" }
  },
  "componentSrcMap": {
    "Alert": "src/components/ui/Alert.tsx",
    "AudioPlayer": "src/components/ui/AudioPlayer.tsx",
    "Badge": "src/components/ui/Badge.tsx",
    "Button": "src/components/ui/Button.tsx",
    "Dialog": "src/components/ui/Dialog.tsx",
    "Dropdown": "src/components/ui/Dropdown.tsx",
    "Input": "src/components/ui/Input.tsx",
    "PathDisplay": "src/components/ui/PathDisplay.tsx",
    "ResetButton": "src/components/ui/ResetButton.tsx",
    "Select": "src/components/ui/Select.tsx",
    "SettingContainer": "src/components/ui/SettingContainer.tsx",
    "SettingsGroup": "src/components/ui/SettingsGroup.tsx",
    "Slider": "src/components/ui/Slider.tsx",
    "TextDisplay": "src/components/ui/TextDisplay.tsx",
    "Textarea": "src/components/ui/Textarea.tsx",
    "ToggleSwitch": "src/components/ui/ToggleSwitch.tsx",
    "Tooltip": "src/components/ui/Tooltip.tsx",
    "ProgressBar": "src/components/shared/ProgressBar.tsx",
    "CancelIcon": "src/components/icons/CancelIcon.tsx",
    "HandyHand": "src/components/icons/HandyHand.tsx",
    "HandyTextLogo": "src/components/icons/HandyTextLogo.tsx",
    "MicrophoneIcon": "src/components/icons/MicrophoneIcon.tsx",
    "ResetIcon": "src/components/icons/ResetIcon.tsx",
    "TranscriptionIcon": "src/components/icons/TranscriptionIcon.tsx"
  }
}
