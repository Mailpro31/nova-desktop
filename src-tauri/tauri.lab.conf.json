{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova Lab",
  "identifier": "app.novaspeak.desktop.lab",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/app.novaspeak.desktop.lab/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
